{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=feedback;User=<db-user>;Password=<db-password>;"
  },
  "Jwt": {
    "IssuerSigningKey": "<base64-or-random-string-at-least-32-chars-for-HMAC-SHA256>",
    "Issuer": "https://localhost:7016",
    "Audience": "https://localhost:7016",
    "ExpireMinutes": 60,
    "RefreshExpiresMinutes": 4320,
    "CookieName": "feedback_access_token",
    "RefreshCookieName": "feedback_refresh_token"
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:5173"]
  }
}
